# Copie este arquivo para ".env" e cole sua chave do Gemini (Google AI Studio).
# NUNCA coloque o .env no GitHub nem no ZIP da entrega.
GOOGLE_API_KEY=cole_sua_chave_aqui

# Opcionais. Por padrão o código escolhe sozinho um modelo que a sua conta enxerga.
# Só preencha se quiser forçar um nome (rode `python scripts/listar_modelos.py` para ver os disponíveis):
# GEMINI_MODELO_LLM=models/gemini-3.5-flash-lite
# GEMINI_MODELO_EMBEDDING=models/gemini-embedding-001
# LIMIAR_RELEVANCIA=0.65
# K_RECUPERACAO=4
# MAX_CHAMADAS_FERRAMENTA=4
